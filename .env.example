# Wida3.ma — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Database
DB_NAME=wida3
DB_USER=wida3_app
DB_PASSWORD=

# Backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wida3
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7
# false for local/localhost-as-VPS (plain HTTP, see Architecture ADR re: MVP deployment); true once real TLS is in front
JWT_REFRESH_COOKIE_SECURE=false

# Payment — mock gateway for MVP (see docs/architecture-wida3-ma.md ADR-5)
PAYMENT_MODE=MOCK

# File storage — local disk volume for MVP (see docs/architecture-wida3-ma.md ADR-6)
FILE_STORAGE_PATH=/app/uploads

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
