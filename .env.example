# Wida3.ma — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# Database
DB_NAME=wida3
DB_USER=wida3_app
DB_PASSWORD=

# Backend (Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/wida3
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MIN=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Payment gateway — provider TBD (see docs/system-design-wida3-ma.md SDR-4)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=

# File/object storage — provider TBD (see docs/system-design-wida3-ma.md SDR-4)
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_KEY=
FILE_STORAGE_SECRET=
FILE_STORAGE_BUCKET=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
